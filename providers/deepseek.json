{
  "id": "deepseek",
  "name": "DeepSeek(OpenAI 兼容 Chat Completions)",
  "wire_api": "chat",
  "base_url": "https://api.deepseek.com/v1",
  "env_key": "DEEPSEEK_API_KEY",
  "auth_modes": [
    "api_key"
  ],
  "requires_openai_auth": false,
  "default_model": "deepseek-chat",
  "responses_support": "none",
  "stream_format": "chat-completions-sse",
  "tool_calls": true,
  "reasoning": "separate-field(reasoning_content,deepseek-reasoner)",
  "context_limit_tokens": 128000,
  "retryable_errors": [
    "429",
    "5xx",
    "stream-idle"
  ],
  "known_incompatibilities": [
    "previous_response_id 不支持(Chat 协议本就无此概念,由 Codex 维护上下文)",
    "reasoning item 非 Responses 形态,Codex 可能不展示"
  ],
  "matrix": {
    "status": "untested",
    "note": "需 DEEPSEEK_API_KEY;用 provider_matrix.ts 跑 10 项后回填"
  },
  "verified_at": null
}

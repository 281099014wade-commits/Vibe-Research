{
  "id": "kimi",
  "name": "Moonshot Kimi(OpenAI 兼容 Chat Completions)",
  "wire_api": "chat",
  "base_url": "https://api.moonshot.cn/v1",
  "env_key": "MOONSHOT_API_KEY",
  "auth_modes": [
    "api_key"
  ],
  "requires_openai_auth": false,
  "default_model": "kimi-k2-0711-preview",
  "responses_support": "none",
  "stream_format": "chat-completions-sse",
  "tool_calls": true,
  "reasoning": "model-dependent",
  "context_limit_tokens": 131072,
  "retryable_errors": [
    "429",
    "5xx",
    "stream-idle"
  ],
  "known_incompatibilities": [
    "previous_response_id 不支持"
  ],
  "matrix": {
    "status": "untested",
    "note": "需 MOONSHOT_API_KEY;用 provider_matrix.ts 跑 10 项后回填"
  },
  "verified_at": null
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened Runtime 的豁免项。**公证要求必须开 hardened runtime**，而开了之后默认规则会把
  这个 App 该做的事全挡掉 —— 下面每一条都对应一个"不给就跑不起来"的具体功能，不是随手加的。

  🔴 **这不是 App Sandbox**：这里没有 `com.apple.security.app-sandbox`。沙盒是 Mac App Store 的
     强制要求，而我们走的是 Developer ID 直发那条路（沙盒不让起 Python 子进程、不让跑捆绑引擎、
     不让写 ~/.vibe-research-agent，那条路对本产品走不通）。
-->
<plist version="1.0">
<dict>
  <!-- V8 要 JIT。Electron 的主 / 渲染进程都靠它，不给直接起不来 -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Node/V8 会往可写内存里写代码再执行。allow-jit 覆盖不到的那部分靠这条 -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    🔴 这一条是本产品特有的、也是最要紧的：
    我们捆绑了**一整棵 Python**（几百个 .so）和**引擎二进制**（codex + rg）。
    库校验打开时，进程只能加载"同一个 Team 签的"库 —— 而那些 .so 是 python-build-standalone
    的产物，不是我们签的。不给这条，Python 一 import numpy 就崩，
    而且**崩在用户点了"取数"之后**，不是启动时。
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!--
    编排器给子进程拼环境变量（模型 key、PATH、PYTHONHOME…）。hardened runtime 默认会
    清掉 DYLD_* 一类变量；可重定位的 Python 布局依赖它们找得到自己的库。
  -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>

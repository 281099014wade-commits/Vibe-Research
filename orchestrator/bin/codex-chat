#!/bin/sh
# 对话专用 Codex 启动器：认证仍从 CODEX_HOME 读取，但不加载其中的 config.toml。
# 这样用户后来加进产品配置的 MCP / 插件也不会进入“用户资料命中片段 → 回答”这条受限通道。
set -eu

if [ -z "${VRA_CODEX_REAL_BIN:-}" ]; then
  echo "VRA_CODEX_REAL_BIN is required" >&2
  exit 64
fi

if [ "${1:-}" = "exec" ]; then
  shift
  exec "$VRA_CODEX_REAL_BIN" exec --ignore-user-config --ignore-rules "$@"
fi

exec "$VRA_CODEX_REAL_BIN" "$@"
